  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Workout Sync Flow",
      "items": [
        "Offline-first PWA executes workouts locally via React 19 + Zustand and writes to localStorage",
        "Changes debounce-sync over HTTPS to Nginx (:8080), which proxies /api/data to Node API (:3000)",
        "API executes atomic temp-write and rename for state-<uid>.json under the bind-mounted /data volume"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Passkey Auth",
      "items": [
        "Passwordless FIDO2 / WebAuthn credentials verified via @simplewebauthn and bound to RP_ID",
        "Signed session cookies HMAC'd with 32-byte DATA_DIR/secret (default 90-day validity)",
        "Nginx enforces single origin, injects real client IP, and blocks framing (DENY + CSP frame-ancestors 'none')"
      ]
    },
    {
      "dot": "cyan",
      "title": "External Integrations & Assets",
      "items": [
        "Web Push gateway dispatches rest-timer-over and daily reminder notifications via VAPID keys",
        "One-shot media service pulls 140MB exercise image/GIF dataset from Git upstream into shared volume",
        "Zero third-party telemetry, tracking pixels, or remote database services required"
      ]
    },
    {
      "dot": "violet",
      "title": "MCP Assistant & Mobile Runtime",
      "items": [
        "Standalone MCP server provides read-only stdio bridge for Claude Desktop and Cursor directly from /data",
        "Optional Capacitor shells wrap frontend into standalone Android/iOS APKs with native file mirroring",
        "Admin dashboard exposes instance KPIs, member directory, and audit logs without external analytics"
      ]
    }
  ]
